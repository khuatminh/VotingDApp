{
  "name": "voting-dapp",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized voting DApp (academic). Foundry + React/Vite monorepo.",
  "scripts": {
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test -vv",
    "sync-abi": "bash scripts/sync-abi.sh",
